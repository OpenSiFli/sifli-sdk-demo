menu "XiaoZhi over Bluetooth PAN"

config LEARNING_CAMERA_BT_NAME
    string "Bluetooth device name"
    default "sifli-learning-camera"

config LEARNING_CAMERA_PAN_CONNECT_DELAY_MS
    int "PAN connect delay after pairing (ms)"
    default 3000
    range 1000 10000

config LEARNING_CAMERA_PAN_RETRY_DELAY_MS
    int "PAN reconnect delay (ms)"
    default 10000
    range 1000 60000

config LEARNING_CAMERA_PAN_RETRY_MAX
    int "PAN reconnect attempts"
    default 5
    range 1 20

endmenu

config CUSTOM_MEM_MAP
    bool
    select custom_mem_map
    default y if !SOC_SIMULATOR

source "$SIFLI_PERIPHERALS_ROOT/camera_framework/Kconfig"
