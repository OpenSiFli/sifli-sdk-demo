menu "XiaoZhi over Bluetooth PAN"

config LEARNING_CAMERA_BT_NAME
    string "Bluetooth device name"
    default "sifli-learning-camera"

config LEARNING_CAMERA_PAN_CONNECT_DELAY_MS
    int "PAN connect delay after pairing (ms)"
    default 3000
    range 1000 10000

config LEARNING_CAMERA_PAN_RETRY_DELAY_MS
    int "PAN reconnect delay (ms)"
    default 10000
    range 1000 60000

config LEARNING_CAMERA_PAN_RETRY_MAX
    int "PAN reconnect attempts"
    default 5
    range 1 20

endmenu

menu "Assistant UI diagnostics"

config LEARNING_CAMERA_UI_LOG
    bool "Camera UI timing and redraw diagnostics"
    default y

config LEARNING_CAMERA_FPS_LOG
    bool "Camera fps diagnostics"
    default y

endmenu

config CUSTOM_MEM_MAP
    bool
    select custom_mem_map
    default y if !SOC_SIMULATOR

menu "Board camera hardware"

config CAMERA_I2C_DEVICE_NAME
    string "SCCB I2C device name"
    default "i2c1"

config CAMERA_XCLK_ENABLE
    bool "MCU drives the camera MCLK"
    default y

config CAMERA_XCLK_PWM_DEVICE_NAME
    string "PWM device that drives the camera MCLK"
    default "pwmt2"
    depends on CAMERA_XCLK_ENABLE

config CAMERA_XCLK_PWM_CHANNEL
    int "PWM channel that drives the camera MCLK"
    default 1
    depends on CAMERA_XCLK_ENABLE

config CAMERA_DCMI_PCLK_FALLING
    bool "Sample the DVP pixel clock on the falling edge"
    default n

endmenu

# The camera framework Kconfig (CAMERA_FRAMEWORK_ENABLE, sensor/data-bus
# selection) now comes from the libcamera sf-pkg component: the build Kconfig
# gets `osource "<project>/sf-pkgs/Kconfig.conandeps"`, which sources
# sf-pkgs/full_deploy/host/libcamera/<ver>/Kconfig. Do not source it again from
# an out-of-tree checkout.
