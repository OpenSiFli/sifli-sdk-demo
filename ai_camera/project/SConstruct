import os
import rtconfig

SIFLI_SDK = os.getenv('SIFLI_SDK')
if not SIFLI_SDK:
    print('Please source the SiFli SDK export script first.')
    exit()

# The camera framework is a sf-pkg component (libcamera/<ver>@sifli, see
# sf-pkg.yaml). Its Kconfig and SConscript are pulled in by the generated
# sf-pkgs/Kconfig.conandeps and sf-pkgs/SConscript_conandeps, so no external
# source tree has to be pointed at with SIFLI_PERIPHERALS_ROOT any more.

from building import *

PrepareEnv()
AddBootLoader(SIFLI_SDK, rtconfig.CHIP)
SifliEnv()

TARGET = rtconfig.OUTPUT_DIR + rtconfig.TARGET_NAME + '.' + rtconfig.TARGET_EXT
objs = PrepareBuilding(None)
env = GetCurrentEnv()
DoBuilding(TARGET, objs)
AddFTAB(SIFLI_SDK, rtconfig.CHIP, env)
GenDownloadScript(env)
