import os
from building import *

# Encode stable RGB565 frames into JPEG for still photos. This encoder is
# independent of the camera sensor; the decoder is a separate build group.
cwd = GetCurrentDir()
sources = [
    os.path.join(cwd, 'src', 'encoder', 'camera_sw_jpeg_encoder.cpp'),
    os.path.join(cwd, 'vendor', 'jpegenc', 'JPEGENC.cpp'),
]

group = DefineGroup('Camera Software JPEG', sources,
                    depend=['AI_CAMERA_SW_JPEG_ENCODER'],
                    CPPPATH=[os.path.join(cwd, 'include'),
                             os.path.join(cwd, 'vendor', 'jpegenc')],
                    CPPDEFINES=['JPEGENC_PORTABLE'],
                    CCFLAGS='-O2')
Return('group')
