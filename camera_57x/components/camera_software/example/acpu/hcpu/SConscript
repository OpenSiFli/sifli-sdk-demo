import os
from building import *

Import('SIFLI_SDK')

cwd = GetCurrentDir()
root = os.path.abspath(os.path.join(cwd, '../../..'))
group = DefineGroup(
    'Camera Software ACPU Client',
    ['camera_sw_acpu_client.c', 'camera_sw_acpu_run_task.c'],
    depend=[''],
    CPPPATH=[os.path.join(cwd, '../include'),
             os.path.join(root, 'isp/include'),
             os.path.join(root, 'jpeg/include'),
             os.path.join(SIFLI_SDK, 'middleware/acpu_ctrl')])
Return('group')
