#APP specific configuration.
choice
    prompt "Camera sensor backend"
    default CAMERA_SENSOR_GC032A

config CAMERA_SENSOR_GC032A
    bool "GC032A"
    select BSP_USING_DCMI
    select BSP_USING_PWMT2

config CAMERA_SENSOR_ARDUCAM_OV2640
    bool "Arducam OV2640 SPI FIFO"
    select BSP_USING_I2C
    select BSP_USING_I2C1
    select BSP_USING_SPI
    select BSP_USING_SPI2
    select BSP_SPI2_RX_USING_DMA
    select BSP_SPI2_TX_USING_DMA
endchoice

rsource "../components/camera_software/Kconfig"

config CUSTOM_MEM_MAP
    bool
	select custom_mem_map
	default y if !SOC_SIMULATOR
